# URL base de la API del curso (incluye /api). Documentación: https://proyecto-idgs9-v1.onrender.com/api/docs/
# Es pública, así que sirve igual en Expo Go, en el emulador y en el APK.
EXPO_PUBLIC_API_BASE_URL=https://proyecto-idgs9-v1.onrender.com/api
# Token del equipo enviado en el header x-api-token (dado por el docente).
# Expo lo incrusta en el bundle del APK: identifica la app, no es un secreto.
EXPO_PUBLIC_API_APP_TOKEN=utr-idgs9-equipo-c2-xxxxxxxx
