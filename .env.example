# URL base de la API (incluye /api).
# En emulador Android "localhost" es el propio emulador: usa http://10.0.2.2:3000/api.
# En dispositivo físico usa la IP LAN de tu PC, p. ej. http://192.168.1.50:3000/api.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api
# Token de aplicación enviado en el header x-api-token.
# Expo lo incrusta en el bundle del APK: identifica la app, no es un secreto.
EXPO_PUBLIC_API_APP_TOKEN=tu_token_de_aplicacion_aqui
